  <diagram name="Market Assistant Current Workflow" id="market-assistant-current-workflow">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1350" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Market Assistant Current Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="30" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Streamlit + FastAPI + LLM QueryPlan + DuckDB over HK/US parquet files" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#666666" vertex="1" parent="1">
          <mxGeometry x="530" y="72" width="740" height="30" as="geometry" />
        </mxCell>

        <mxCell id="lane_ui" value="Frontend" style="swimlane;html=1;startSize=34;horizontal=0;fillColor=#fff7e6;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="330" height="980" as="geometry" />
        </mxCell>
        <mxCell id="lane_api" value="API Orchestration" style="swimlane;html=1;startSize=34;horizontal=0;fillColor=#f8f9fa;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="430" height="980" as="geometry" />
        </mxCell>
        <mxCell id="lane_llm" value="LLM Boundary" style="swimlane;html=1;startSize=34;horizontal=0;fillColor=#eaf4ff;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="930" y="130" width="310" height="980" as="geometry" />
        </mxCell>
        <mxCell id="lane_data" value="Deterministic Data Layer" style="swimlane;html=1;startSize=34;horizontal=0;fillColor=#eaf7ea;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1290" y="130" width="420" height="980" as="geometry" />
        </mxCell>

        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13" vertex="1" parent="lane_ui">
          <mxGeometry x="35" y="65" width="40" height="70" as="geometry" />
        </mxCell>
        <mxCell id="streamlit" value="Streamlit UI&lt;br&gt;app/ui_streamlit.py&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;chat input, defaults, debug toggle&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="lane_ui">
          <mxGeometry x="115" y="70" width="175" height="82" as="geometry" />
        </mxCell>
        <mxCell id="render" value="Render Response&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;chart, table, commentary,&lt;br&gt;debug expander&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1" vertex="1" parent="lane_ui">
          <mxGeometry x="115" y="770" width="175" height="86" as="geometry" />
        </mxCell>

        <mxCell id="api_chat" value="POST /chat&lt;br&gt;ChatRequest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="70" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="session_defaults" value="1. Session + UI Defaults&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;get/create session&lt;br&gt;normalize date and market&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="175" width="200" height="82" as="geometry" />
        </mxCell>
        <mxCell id="plan_gen" value="2. Generate QueryPlan&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;LLMQueryPlanner.generate_plan()&lt;br&gt;recent history context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="300" width="200" height="86" as="geometry" />
        </mxCell>
        <mxCell id="apply_defaults" value="3. Enforce Request Defaults&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;apply_ui_defaults_to_plan()&lt;br&gt;explicit market/date override only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="425" width="200" height="86" as="geometry" />
        </mxCell>
        <mxCell id="chat_decision" value="query_type is&lt;br&gt;chat/invalid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="lane_api">
          <mxGeometry x="140" y="545" width="140" height="92" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="4. Validate Plan&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;field/operator/schema checks&lt;br&gt;infer query_type if missing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="675" width="200" height="86" as="geometry" />
        </mxCell>
        <mxCell id="chat_answer" value="Direct Answer&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;no DuckDB query&lt;br&gt;append history&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13" vertex="1" parent="lane_api">
          <mxGeometry x="300" y="560" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="postprocess" value="8. Post-process Result&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;filter relevant columns&lt;br&gt;translate Symbol to English&lt;br&gt;build table + summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="805" width="200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="history_response" value="10. Store History + Return&lt;br&gt;ChatResponse&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;table, summary, commentary,&lt;br&gt;optional debug&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="lane_api">
          <mxGeometry x="110" y="925" width="200" height="96" as="geometry" />
        </mxCell>

        <mxCell id="llm_service" value="OpenAI-compatible&lt;br&gt;Chat Completion&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;intent planning and narration only&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="lane_llm">
          <mxGeometry x="55" y="300" width="200" height="92" as="geometry" />
        </mxCell>
        <mxCell id="query_plan_json" value="QueryPlan JSON&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;market, date/date_range&lt;br&gt;query_type, fields&lt;br&gt;filters, order_by, limit&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12" vertex="1" parent="lane_llm">
          <mxGeometry x="55" y="425" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="commentary_llm" value="9. Commentary Prompt&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;generate_commentary()&lt;br&gt;uses plan + result summary&lt;br&gt;must not invent numbers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="lane_llm">
          <mxGeometry x="55" y="805" width="200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="llm_note" value="The LLM does not compute financial metrics. All filtering, sorting, aggregation, and time-series retrieval happen in DuckDB." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#333333" vertex="1" parent="lane_llm">
          <mxGeometry x="45" y="650" width="220" height="82" as="geometry" />
        </mxCell>

        <mxCell id="path_resolver" value="5. Resolve Parquet Paths&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;PathResolver.resolve(date, market)&lt;br&gt;HK, US, or ALL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="lane_data">
          <mxGeometry x="105" y="175" width="210" height="86" as="geometry" />
        </mxCell>
        <mxCell id="parquet_store" value="Local Parquet Data&lt;br&gt;&lt;br&gt;data/hk/*.parquet&lt;br&gt;data/us/*.parquet&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;one daily-history file per stock&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1f0d8;strokeColor=#82b366;fontSize=13" vertex="1" parent="lane_data">
          <mxGeometry x="105" y="295" width="210" height="118" as="geometry" />
        </mxCell>
        <mxCell id="sql_compiler" value="6. Compile SQL&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;SQLCompilerEnhanced.compile()&lt;br&gt;normalizes raw columns&lt;br&gt;basic/filter/raw_data/stats&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="lane_data">
          <mxGeometry x="105" y="455" width="210" height="96" as="geometry" />
        </mxCell>
        <mxCell id="sql_artifact" value="Generated DuckDB SQL&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;parquet_scan(..., union_by_name=true)&lt;br&gt;WHERE / GROUP BY / ORDER BY&lt;br&gt;LIMIT&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Courier New;fontSize=12" vertex="1" parent="lane_data">
          <mxGeometry x="105" y="590" width="210" height="104" as="geometry" />
        </mxCell>
        <mxCell id="duckdb" value="7. Execute with DuckDB&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;in-memory connection&lt;br&gt;returns pandas DataFrame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1" vertex="1" parent="lane_data">
